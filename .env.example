# Optional browser-accessible Solana DEVNET RPC endpoint (must allow CORS).
# Vite exposes VITE_* values in the client bundle. Never put private/server secrets here.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Coupon Core: /protocol reads Anchor accounts. For local validator use http://127.0.0.1:8899.
# Public program address only; synchronize with declare_id!/Anchor.toml before a Devnet deploy.
VITE_RECORDA_PROGRAM_ID=CFyseDHTMkDxMpnozdZpHV5a4fbEkPAkyue5RpHtrobF

# Node Devnet runners automatically read .env.local, then .env.
# Optional override; when omitted they use VITE_SOLANA_RPC_URL above.
# RECORDA_DEVNET_RPC=https://api.devnet.solana.com

# Real Phantom public addresses for test:e2e:actions:devnet. Never seed/private keys.
# Operator is optional but recommended: verifies the initially selected wallet.
RECORDA_OPERATOR=
RECORDA_HOLDER_A=
RECORDA_HOLDER_B=
RECORDA_HOLDER_C=

RECORDA_APP_URL=http://localhost:4444
RECORDA_BROWSER_CDP=http://127.0.0.1:9222
RECORDA_VOTE_SECONDS=900
# Legacy Coupon-only resume before payments; leave unset for fresh runs.
# RECORDA_DEVNET_ACTION=

# Next production shell: public browser values only, baked at build time.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_RECORDA_PROGRAM_ID=CFyseDHTMkDxMpnozdZpHV5a4fbEkPAkyue5RpHtrobF

# BondOps server-only operational layer. Never use VITE_ or NEXT_PUBLIC_ prefixes for these.
# Demo is loopback-only and disabled in production. Live sign-in uses authorized public wallets.
BONDOPS_MODE=demo
BONDOPS_DB_PATH=target/bondops/workspace.sqlite
BONDOPS_ORIGINS=http://127.0.0.1:4444,http://localhost:4444,http://127.0.0.1:3000,http://localhost:3000
BONDOPS_RPC_URL=https://api.devnet.solana.com
BONDOPS_PROGRAM_ID=CFyseDHTMkDxMpnozdZpHV5a4fbEkPAkyue5RpHtrobF
# JSON bootstrap for a new/empty live team; replace with actual public wallet and instrument scopes.
# BONDOPS_MEMBERS=[{"id":"operator-1","name":"Operator","wallet":"YOUR_PUBLIC_WALLET","role":"operator","scopes":["*"]}]
# BONDOPS_BACKGROUND=false
